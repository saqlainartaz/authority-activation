        "$ref": "#/$defs/ConflictV1"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "contract_version": {
      "const": "context.v1",
      "default": "context.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "gaps": {
      "default": [],
